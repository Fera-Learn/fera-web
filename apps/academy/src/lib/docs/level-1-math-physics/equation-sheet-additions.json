        {
          "topicId": "variance",
          "topicTitle": "Variance",
          "label": "Variance identity",
          "tex": "\\operatorname{Var}(X)=\\operatorname E[X^2]-(\\operatorname E[X])^2"
        },
        {
          "topicId": "binomial-distribution",
          "topicTitle": "Binomial Distribution",
          "label": "Binomial probability",
          "tex": "P(X=k)=\\binom nk p^k(1-p)^{n-k}"
        },
        {
          "topicId": "poisson-distribution",
          "topicTitle": "Poisson Distribution",
          "label": "Poisson probability",
          "tex": "P(X=k)=e^{-\\lambda}\\frac{\\lambda^k}{k!}"
        },
        {
          "topicId": "normal-distribution",
          "topicTitle": "Normal Distribution",
          "label": "Normal density",
          "tex": "f(x)=\\frac{1}{\\sigma\\sqrt{2\\pi}}e^{-(x-\\mu)^2/(2\\sigma^2)}"
        },
        {
          "topicId": "standard-normal",
          "topicTitle": "Standard Normal",
          "label": "Standardisation",
          "tex": "Z=\\frac{X-\\mu}{\\sigma}"
        },
        {
          "topicId": "sample-mean",
          "topicTitle": "Sample Mean",
          "label": "Sample mean spread",
          "tex": "\\operatorname E[\\bar X]=\\mu,\\qquad \\operatorname{Var}(\\bar X)=\\frac{\\sigma^2}{n}"
        }
      ]
    },
