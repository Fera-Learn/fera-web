      "sectionTitle": "Probability",
      "equations": [
        {
          "topicId": "probability-axioms",
          "topicTitle": "Probability Axioms",
          "label": "Complement rule",
          "tex": "P(A^c)=1-P(A)"
        },
        {
          "topicId": "events",
          "topicTitle": "Events",
          "label": "Addition rule",
          "tex": "P(A\\cup B)=P(A)+P(B)-P(A\\cap B)"
