        {
          "topicId": "conditional-probability",
          "topicTitle": "Conditional Probability",
          "label": "Conditional probability",
          "tex": "P(A\\mid B)=\\frac{P(A\\cap B)}{P(B)}"
        },
        {
          "topicId": "bayes-theorem",
          "topicTitle": "Bayes Theorem",
          "label": "Bayes theorem",
          "tex": "P(A_i\\mid B)=\\frac{P(B\\mid A_i)P(A_i)}{\\sum_j P(B\\mid A_j)P(A_j)}"
        },
        {
          "topicId": "expectation",
          "topicTitle": "Expectation",
          "label": "Discrete expectation",
          "tex": "\\operatorname E[X]=\\sum_x xP(X=x)"
