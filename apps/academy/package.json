{
  "name": "academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-question-registry.mjs --check && next build",
    "check:math-i-content": "node scripts/validate-math-i-content-quality.mjs",
    "check:physics-a-content": "node scripts/validate-level-2-physics-a-content.mjs",
    "check:physics-a-diagrams": "node scripts/validate-level-2-physics-a-diagrams.mjs",
    "check:physics-b-content": "node scripts/validate-level-2-physics-b-content.mjs",
    "check:physics-b-diagrams": "node scripts/validate-level-2-physics-b-diagrams.mjs",
    "check:physics-b-questions": "node scripts/validate-level-2-physics-b-questions.mjs",
    "check:questions": "node scripts/generate-question-registry.mjs --check",
    "check:math-physics-equation-sheet": "node scripts/validate-math-physics-equation-sheet.mjs",
    "generate:questions": "node scripts/generate-question-registry.mjs",
    "generate:physics-b-questions": "node scripts/generate-level-2-physics-b-thermodynamics-questions.mjs",
