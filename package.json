{
  "name": "fera",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check:diagrams": "node scripts/validate-diagrams-package.mjs && node apps/academy/scripts/validate-chart-demos-diagrams.mjs",
    "check-types": "turbo run check-types && pnpm check:diagrams"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
